isponibilités&lt;br&gt;Rendez-vous : réservation sans doublon, annulation&lt;br&gt;Clients, prestations, horaires, tickets&lt;br&gt;Agenda (Google) et e-mails&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#0A1D35;strokeWidth=2;fontColor=#0A1D35;" vertex="1" parent="1"><mxGeometry x="545" y="455" width="490" height="135" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;Accès aux données&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4A5A70&#x27; style=&#x27;font-size:11px&#x27;&gt;Requêtes SQL par table (repositories)&lt;br&gt;Compte de base aux droits limités&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#0A1D35;strokeWidth=2;fontColor=#0A1D35;" vertex="1" parent="1"><mxGeometry x="545" y="610" width="490" height="90" as="geometry"/></mxCell><mxCell id="jobs" value="&lt;b&gt;Tâches planifiées&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4A5A70&#x27; style=&#x27;font-size:11px&#x27;&gt;Rappel J-1 par e-mail, purge RGPD des anciennes données&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#0A1D35;strokeWidth=2;fontColor=#0A1D35;" vertex="1" parent="1"><mxGeometry x="545" y="720" width="490" height="70" as="geometry"/></mxCell><mxCell id="t_cli" value="&lt;b&gt;clients&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4A5A70&#x27; style=&#x27;font-size:11px&#x27;&gt;id, nom, prénom&lt;br&gt;email, téléphone&lt;br&gt;date de consentement&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#0A1D35;strokeWidth=2;fontColor=#0A1D35;" vertex="1" parent="1"><mxGeometry x="1135" y="145" width="200" height="110" as="geometry"/></mxCell><mxCell id="t_pre" value="&lt;b&gt;prestations&l