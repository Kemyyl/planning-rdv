<mxfile host="app.diagrams.net"><diagram name="Architecture dev"><mxGraphModel dx="1600" dy="1120" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1120"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z_front" value="FRONT · REACT + TYPESCRIPT (VITE)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D0E7F5;strokeColor=#6CAED6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#0A1D35;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="440" height="710" as="geometry"/></mxCell><mxCell id="z_back" value="BACK · NODE.JS + TYPESCRIPT (EXPRESS)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0A1D35;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#0A1D35;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="540" height="710" as="geometry"/></mxCell><mxCell id="z_data" value="DONNÉES · POSTGRESQL" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2E8DC;strokeColor=#0A1D35;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#0A1D35;" vertex="1" parent="1"><mxGeometry x="1110" y="100" width="460" height="560" as="geometry"/></mxCell><mxCell id="z_ext" value="SERVICES EXTERNES" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F1E8;strokeColor=#D9C9B4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#0A1D35;" vertex="1" parent="1"><mxGeometry x="1110" y="700" width="460" height="270" as="geometry"/></mxCell><mxCell id="pub" value="&lt;b&gt;Pages publiques&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4A5A70&#x27; style=&#x27;font-size:11px&#x27;&gt;Prise de rendez-vous (prestation, date, créneau)&lt;br&gt;Confirmation&lt;br&gt;Mon rendez-vous (consulter, annuler)&lt;br&gt;Signaler un problème (ticket)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=1